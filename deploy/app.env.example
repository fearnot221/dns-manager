# Copy OUTSIDE the checkout to /home/snmg/config/app.env; restrict read access.
# Generate each of these independently. Never commit populated secrets.
POSTGRES_DATA_DIR=/home/snmg/data/postgres
POSTGRES_PASSWORD=
AUTH_SECRET=
SETTINGS_ENCRYPTION_KEY=
AUTH_URL=https://dnsmgr.ce.ncu.edu.tw
WEB_PORT=3000

# From Logto traditional web application; UI still says NCU Portal.
# Set false to disable password login after testing.
AUTH_PASSWORD_LOGIN_ENABLED=true
AUTH_LOGTO_ID=dtvpigx50sgdvy4aeadee
AUTH_LOGTO_SECRET=
# Owner authorization comes from verified NCU identity details.identifier, not an env subject.

PDNS_MOCK=false
# Docker localhost is the web container, NOT the host's PowerDNS.
PDNS_API_URL=
PDNS_API_KEY=
PDNS_SERVER_ID=localhost

# Only for first-time seed. Remove after successful owner initialization.
OWNER_INITIAL_PASSWORD=
