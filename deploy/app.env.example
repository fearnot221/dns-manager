# Copy OUTSIDE the checkout to /etc/dns-manager/app.env; restrict read access.
# Generate each of these independently. Never commit populated secrets.
POSTGRES_PASSWORD=
AUTH_SECRET=
SETTINGS_ENCRYPTION_KEY=
AUTH_URL=https://dnsmgr.ce.ncu.edu.tw
WEB_PORT=3000

# From NCU Portal OAuth2 application registration.
NCU_PORTAL_CLIENT_ID=
NCU_PORTAL_CLIENT_SECRET=
# Operator-verified Portal account identifier for fearnot@ce.ncu.edu.tw.
NCU_OWNER_IDENTIFIER=

PDNS_MOCK=false
# Docker localhost is the web container, NOT the host's PowerDNS.
PDNS_API_URL=
PDNS_API_KEY=
PDNS_SERVER_ID=localhost
PDNS_ALLOWED_ORIGINS=

# Only for first-time seed. Remove after successful owner initialization.
OWNER_INITIAL_PASSWORD=
