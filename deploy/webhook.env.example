# Copy to /etc/dns-manager/webhook.env, owner root, group dnsdeploy, mode 0640.
WEBHOOK_SECRET=
WEBHOOK_PORT=9000
WEBHOOK_STATE_DIR=/var/lib/dns-manager-webhook
DEPLOY_SCRIPT=/opt/dns-manager-deploy/deploy.sh
DEPLOY_DIR=/opt/dns-manager
DEPLOY_ENV_FILE=/etc/dns-manager/app.env
DEPLOY_REPOSITORY=YOUR_OWNER/YOUR_REPO
DEPLOY_BRANCH=main
