# Copy to /home/snmg/config/webhook.env, owner root, group dnsdeploy, mode 0640.
WEBHOOK_SECRET=
WEBHOOK_PORT=9000
WEBHOOK_STATE_DIR=/home/snmg/state/webhook
DEPLOY_STATE_DIR=/home/snmg/state/webhook
DEPLOY_SCRIPT=/home/snmg/deploy/deploy.sh
DEPLOY_DIR=/home/snmg/dns-manager
DEPLOY_ENV_FILE=/home/snmg/config/app.env
DEPLOY_REPOSITORY=YOUR_OWNER/YOUR_REPO
DEPLOY_BRANCH=main
