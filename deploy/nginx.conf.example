# Replace dns.example.edu.tw and certificate paths; never install placeholders.
server {
    listen 80;
    server_name dns.example.edu.tw;
    return 301 https://dns.example.edu.tw$request_uri;
}
server {
    listen 443 ssl;
    server_name dns.example.edu.tw;
    ssl_certificate /etc/letsencrypt/live/dns.example.edu.tw/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dns.example.edu.tw/privkey.pem;
    client_max_body_size 2m;
    location = /hooks/github {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:9000;
        proxy_set_header Host dns.example.edu.tw;
        proxy_read_timeout 20s;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host dns.example.edu.tw;
        proxy_set_header X-Forwarded-Host dns.example.edu.tw;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
    }
}
