generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ZoneRole {
  VIEWER
  EDITOR
  ADMIN
}

enum DnsRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id               String           @id @default(cuid())
  name             String?
  studentId        String?
  logtoName        String?
  portalEmail      String?
  note             String           @default("")
  email            String           @unique
  passwordHash     String?
  disabled         Boolean          @default(false)
  removedAt        DateTime?
  emailVerified    DateTime?
  image            String?
  globalRole       GlobalRole       @default(USER)
  lastLoginAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  accounts         Account[]
  sessions         Session[]
  zonePermissions  ZonePermission[]
  groupMemberships GroupMember[]
  auditLogs        AuditLog[]
  recordRequests   DnsRecordRequest[] @relation("RecordRequestOwner")
  reviewedRequests DnsRecordRequest[] @relation("RecordRequestReviewer")
  unitMemberships UnitMember[]
  contactMessages ContactMessage[]
  inspectionTasks InspectionTask[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ZonePermission {
  id                 String    @id @default(cuid())
  userId             String
  zoneName           String
  role               ZoneRole
  resourcePattern    String?
  allowedRecordTypes String[]  @default([])
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, zoneName])
  @@index([zoneName])
}

model Group {
  id              String                @id @default(cuid())
  name            String                @unique
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  members         GroupMember[]
  zonePermissions GroupZonePermission[]
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model GroupZonePermission {
  id              String    @id @default(cuid())
  groupId         String
  zoneName        String
  role            ZoneRole
  resourcePattern String?
  expiresAt       DateTime?
  group           Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, zoneName])
}

model AuditLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  userId       String?
  userEmail    String
  zone         String
  recordName   String?
  recordType   String?
  action       String
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  userAgent    String?
  requestId    String?
  success      Boolean
  errorMessage String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([zone, createdAt])
  @@index([userId, createdAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ProtectedRecordRule {
  id            String   @id @default(cuid())
  zonePattern   String
  recordPattern String
  recordType    String
  minimumRole   ZoneRole @default(ADMIN)
  createdAt     DateTime @default(now())

  @@unique([zonePattern, recordPattern, recordType])
}

model RecordTypePolicy {
  id           String   @id @default(cuid())
  zoneName     String
  role         ZoneRole
  allowedTypes String[]
  updatedAt    DateTime @updatedAt

  @@unique([zoneName, role])
}

model DnsRecordRequest {
  id          String           @id @default(cuid())
  userId      String
  applicationId String?
  unitId      String?
  unit        DnsUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  sourceRecordId String?
  originalContent String? @db.Text
  expectedRRSet Json?
  connectionScope String?
  applicantName String?
  applicantUnit String?
  applicantExtension String?
  zoneName    String
  recordName  String
  recordType  String
  content     String           @db.Text
  ttl         Int
  purpose     String?          @db.Text
  status      DnsRequestStatus @default(PENDING)
  reviewerId  String?
  reviewNote  String?          @db.Text
  reviewedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation("RecordRequestOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewer    User?            @relation("RecordRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([applicationId])
  @@index([unitId, status])
  @@index([zoneName, status, createdAt])
  @@index([status, createdAt])
}

model DnsRecordMetadata {
  id                 String   @id
  zoneName           String
  recordName         String
  recordType         String
  content            String   @db.Text
  unitId             String?
  unit               DnsUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  applicantName      String   @default("")
  applicantEmail     String   @default("")
  applicantUnit      String   @default("")
  applicantExtension String   @default("")
  purpose            String   @default("") @db.Text
  updatedBy          String
  updatedAt          DateTime @updatedAt
  inspections        DnsInspection[]
  inspectionTasks    InspectionTask[]
  @@index([zoneName])
  @@index([unitId])
}

model ContactMessage {
  id String @id @default(cuid())
  userId String
  subject String
  body String @db.Text
  reply String? @db.Text
  repliedBy String?
  repliedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
}

model InspectionTask {
  id String @id @default(cuid())
  recordId String
  userId String
  createdBy String
  createdAt DateTime @default(now())
  status String @default("PENDING")
  snapshot Json
  response String? @db.Text
  respondedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  record DnsRecordMetadata @relation(fields: [recordId], references: [id], onDelete: Restrict)
  @@index([userId, status])
  @@index([recordId, createdAt])
}

enum UnitRole {
  VIEWER
  EDITOR
  ADMIN
}

model DnsUnit {
  id String @id @default(cuid())
  name String @unique
  passcodeHash String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members UnitMember[]
  records DnsRecordMetadata[]
  requests DnsRecordRequest[]
}

model UnitMember {
  unitId String
  userId String
  role UnitRole @default(VIEWER)
  joinedAt DateTime @default(now())
  unit DnsUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([unitId, userId])
  @@index([userId])
}

model DnsInspection {
  id            String   @id @default(cuid())
  recordId      String
  inspectedAt   DateTime @default(now())
  inspectorId   String
  inspectorEmail String
  inspectorName String
  note          String   @db.Text
  record        DnsRecordMetadata @relation(fields: [recordId], references: [id], onDelete: Restrict)
  @@index([recordId, inspectedAt])
}
